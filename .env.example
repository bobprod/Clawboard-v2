# ─── Clawboard — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in the values.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Security ─────────────────────────────────────────────────────────────────
# Bearer token for API authentication. Leave empty for unauthenticated dev mode.
CLAWBOARD_SECRET=

# AES-256-GCM key (64 hex chars) for encrypting API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAWBOARD_KEK=

# ─── Auto-amélioration des agents ─────────────────────────────────────────────
# Backend de stockage des savoirs améliorés (SKILL.md / SOUL.md) :
#   sql   → index PostgreSQL (défaut, rapide)
#   git   → dépôt Git = source de vérité (SOUL.md, skills/*.md versionnés)
#   vault → vault Obsidian (connaissance humaine lisible/éditable)
CLAWBOARD_IMPROVEMENT_STORE=sql

# Cible du backend `git` (dépôt où écrire les compétences et les directives).
CLAWBOARD_IMPROVEMENT_REPO=

# Cible du backend `vault` (dossier du vault Obsidian).
CLAWBOARD_IMPROVEMENT_VAULT=

# Intervalle du job de détection des patterns (ms). Défaut : 6 heures.
CLAWBOARD_IMPROVEMENT_SCAN_INTERVAL=21600000

# Clé de signature de la provenance des améliorations (HMAC-SHA256).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAWBOARD_PROVENANCE_KEY=

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://clawboard:clawboard@localhost:5432/clawboard

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LLM API Keys (optional — can also be set via Settings > API Keys in the UI)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# ─── Ollama (local models) ────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Optional: auth token injected at build time (CI/CD)
VITE_AUTH_TOKEN=
